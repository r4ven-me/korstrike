# Copy this file to .env and fill in real values before `docker compose up`.
# `.env` itself is gitignored — never commit real passwords.

### --- Game server ---

# Port players connect to (UDP). Forward this on your router if hosting from home.
GAME_PORT=27015

# Name shown in the server browser.
SERVER_HOSTNAME=Korstrike CS 1.6

# RCON password. REQUIRED — the container refuses to start without it.
# Generate one with: openssl rand -hex 16
RCON_PASSWORD=

# Password required to join the server. Leave empty for an open (no password) server.
SV_PASSWORD=

# Max players.
MAXPLAYERS=16

# Map the server boots into on first start (must exist in mapcycle.txt or maps/).
STARTMAP=de_dust2

# Gameplay cvars.
MP_TIMELIMIT=30
MP_FRIENDLYFIRE=0
MP_AUTOTEAMBALANCE=1
MP_LIMITTEAMS=2

# Network tick rate (GoldSrc sys_ticrate). 1000 is the classic 1.6 default.
TICKRATE=1000
SV_MAXRATE=20000
SV_MINRATE=3000

# Automatically fetch maps listed in maps/maps-list.txt on container start.
DOWNLOAD_MAPS=true

# Salt used by ReUnion to generate stable SteamIDs for non-Steam ("no-steam")
# clients, so both Steam and non-Steam friends can connect. Leave empty to
# auto-generate one on first start and persist it on the korstrike_data volume —
# only set this yourself if you need it to survive a volume wipe.
REUNION_STEAMID_SALT=

### --- Web panel ---

# Port the control panel web UI listens on (plain HTTP, LAN/port-forward use).
PANEL_PORT=8080

# Panel login. REQUIRED.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Session signing secret. Leave empty to auto-generate and persist one on first run.
SESSION_SECRET=
